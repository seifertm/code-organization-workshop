{
	"build": {
		"dockerfile": "../Dockerfile",
		"target": "devcontainer",
		"options": [
			"--platform=linux/amd64"
		]
	},
	"containerEnv": {
		"VIRTUAL_ENV": "/home/developer/.venv"
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"ms-python.vscode-pylance",
			],
			"settings": {
				"python.defaultInterpreterPath": "/home/developer/.venv/bin/python"
			}
		}
	},
	"onCreateCommand": "containerWorkspaceFolder=${containerWorkspaceFolder} ./.devcontainer/onCreateCommand.sh"
}
